DB_HOST=YOUR_DB_HOST
DB_PORT=3306
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_NAME=YOUR_DB_NAME
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
PORT=5000

# Exact browser origins, separated by commas, WITHOUT trailing slash.
# The production domain and localhost:3000 are allowed by default.
# Configure the exact Vercel preview URL when deploying staging.
CORS_ALLOWED_ORIGINS=https://YOUR-PREVIEW.vercel.app

# Only allow schema synchronization in isolated development or CI.
# Never enable against a populated staging/production database.
DB_SYNCHRONIZE=false
